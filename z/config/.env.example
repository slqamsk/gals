# /z/config/.env.example
# Скопируй в .env (на сервере), заполни реальными значениями.
# Файл .env НЕ коммитится в git (см. .gitignore).

DB_HOST=localhost
DB_NAME=имя_бд
DB_USER=пользователь_бд
DB_PASS=пароль_бд

# Должен совпадать с API_KEY в index.html и X-API-Key в Postman.
API_KEY=test-key-12345