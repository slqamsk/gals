    {
      "name": "install (создать таблицу)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('action is created or exists', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(['created', 'exists']).to.include(json.action);",
              "    pm.expect(json.table).to.eql('sleep_events');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "test-key-12345", "type": "text" }
        ],
        "url": {
          "raw": "https://slqa.ru/z/api/install",
          "protocol": "https",
          "host": ["slqa", "ru"],
          "path": ["z", "api", "install"]
        }
      },
      "response": []
    },
    {
      "name": "get (список событий)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Content-Type is JSON', function () {",
              "    const ct = pm.response.headers.get('Content-Type') || '';",
              "    pm.expect(ct).to.include('application/json');",
              "});",
              "",
              "pm.test('Body is an array', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "});",
              "",
              "pm.test('Each event has required fields', function () {",
              "    const json = pm.response.json();",
              "    json.forEach(function (item) {",
              "        pm.expect(item).to.have.property('id');",
              "        pm.expect(item).to.have.property('event_type');",
              "        pm.expect(item.event_type).to.be.oneOf(['wake', 'sleep']);",
              "        pm.expect(item).to.have.property('event_time');",
              "    });",
              "});",
              "",
              "pm.test('Response time < 2000ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "test-key-12345",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://slqa.ru/z/api/events/",
          "protocol": "https",
          "host": ["slqa", "ru"],
          "path": ["z", "api", "events", ""]
        }
      },
      "response": []
    },
    {
      "name": "post (создать событие)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has numeric id', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.id).to.be.a('number');",
              "});",
              "",
              "pm.test('event_type matches sent', function () {",
              "    const sent = JSON.parse(pm.request.body.raw);",
              "    const json = pm.response.json();",
              "    pm.expect(json.event_type).to.eql(sent.event_type);",
              "});",
              "",
              "pm.test('event_time is valid date string', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(Number.isNaN(Date.parse(json.event_time))).to.be.false;",
              "});",
              "",
              "pm.test('Save event id for later use', function () {",
              "    const json = pm.response.json();",
              "    if (json.id) {",
              "        pm.collectionVariables.set('last_event_id', json.id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-Key",
            "value": "test-key-12345",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"event_type\": \"wake\",\r\n    \"event_time\": \"2026-11-03T07:15:00Z\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
